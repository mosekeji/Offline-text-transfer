/* ==================== 发送模式 ==================== */
.page {
  padding-bottom: 40rpx;
}

/* 输入区 */
.input {
  width: 100%;
  min-height: 200rpx;
  max-height: 520rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text);
  background: #F8FAFD;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.input-ph {
  color: #A9B3C1;
  font-size: 28rpx;
}

.input-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.link {
  font-size: 26rpx;
  color: var(--brand);
  padding: 6rpx 10rpx;
}

/* 二维码区 */
.qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
}

/* 舞台：canvas 与占位提示叠放；canvas 始终在正常位置，保证能查到节点 */
.qr-stage {
  position: relative;
  width: 100%;
  min-height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-canvas {
  display: block;
  background: #fff;
  border-radius: 12rpx;
}

/* 已生成时才加阴影，避免未生成时的白色方块显得突兀 */
.qr-canvas-ready {
  box-shadow: 0 6rpx 20rpx rgba(31, 42, 55, .10);
}

.qr-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  border: 3rpx dashed var(--line);
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #fff;
}

.qr-empty-ico {
  font-size: 110rpx;
  line-height: 1;
  margin-bottom: 20rpx;
  color: #D7DEEA;
}

.qr-empty-text {
  font-size: 30rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

.qr-empty-sub {
  font-size: 24rpx;
  color: var(--text-3);
}

.qr-meta {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
}

.qr-meta-dot {
  margin: 0 12rpx;
}

/* 纠错等级 */
.ecl-row {
  display: flex;
  gap: 16rpx;
}

.ecl-item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #F5F7FB;
  color: var(--text-2);
  font-size: 27rpx;
  font-weight: 600;
  transition: all .2s;
}

.ecl-item.active {
  background: var(--brand-soft);
  color: var(--brand);
  box-shadow: inset 0 0 0 2rpx rgba(74, 99, 231, .35);
}

/* 提示 */
.tips {
  padding: 8rpx 12rpx 0;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.9;
}
